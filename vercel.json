{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "npm run verify",
  "outputDirectory": "build",
  "functions": {
    "api/execute.js": {
      "maxDuration": 60
    },
    "api/keepalive.js": {
      "maxDuration": 15
    },
    "api/room-sync.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
